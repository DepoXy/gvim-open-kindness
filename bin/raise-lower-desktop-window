# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

toggle_window_focus() {
  if os_is_linux; then
    toggle_window_focus_linux "$@"
  elif os_is_macos; then
    toggle_window_focus_macos "$@"
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

toggle_window_focus_linux() {
  local win_before

  # Fetch window ID, e.g., '65012405'.
  # SPIKE/2025-01-14: What if no windows focused?
  if ! ${RAISELOWER_RAISE_ONLY:-false}; then
    win_before="$(get_focused_window_id "${de_name}")" \
      || true
  fi

  # Raise window(s) aka bring window(s) to front
  # using name(s) passed as args.
  if ! raise_window "${de_name}" "$@"; then

    return 1
  fi

  if ${RAISELOWER_RAISE_ONLY:-false}; then

    return 0
  fi

  # TRACK/2024-12-01 04:54: If the frontmost window is not the one
  # being raised, but it's minimized when you run this command, you
  # might need to hold off for a split second for `wmctrl -a` to
  # finish raising the intended target.
  # - E.g.:
  #
  #   sleep 0.13

  local win_after
  if ! win_after="$(get_focused_window_id "${de_name}")"; then

    return 1
  fi

  if [ "${win_before}" = "${win_after}" ]; then
    # Window was already topmost, so minimize (iconify) it.
    minimize_window "${de_name}" "${win_before}"
  fi
}

# ***

# REFER: Depends on GNOME Shell Extension:
#   https://extensions.gnome.org/extension/4724/window-calls/
#   https://github.com/ickyicky/window-calls
get_focused_window_id() {
  local de_name="$1"

  if [ "${de_name}" = "GNOME" ]; then
    get_window_ids_Wayland ${_is_focused:-true}
  elif [ "${de_name}" = "MATE" ]; then
    get_focused_window_id_XWindow
  fi
}

get_window_ids_Wayland() {
  local _is_focused="${1:-false}"

  local windows_list_parenquoted
  # E.g., ('{JSON}')
  if ! windows_list_parenquoted="$(
    gdbus call --session --dest org.gnome.Shell \
      --object-path /org/gnome/Shell/Extensions/Windows \
      --method org.gnome.Shell.Extensions.Windows.List
  )"; then
    # SAVVY: check_deps should make this path unreachable.
    # E.g. — Error: GDBus.Error:org.freedesktop.DBus.Error.UnknownMethod:
    #   Object does not exist at path “/org/gnome/Shell/Extensions/Foo”
    alert_missing_gnome_extension_window_calls

    return 1
  fi

  # USAGE: E.g.,
  #   RAISELOWER_TRACE_DIR=/tmp/rltrace ./raise-lower-desktop-window
  if [ -n "${RAISELOWER_TRACE_DIR}" ]; then
    mkdir -p -- "${RAISELOWER_TRACE_DIR}"
    echo "${windows_list_parenquoted}" > "${RAISELOWER_TRACE_DIR}/RLTRACE-01-WINSLIST_RAW"
  fi

  # Ignore errors, e.g.,
  #   "Error: GDBus.Error:org.gnome.gjs.JSError.Error: Not found"
  # though that probably only happens when you're debugging, and you're
  # manually replaying windows_list you captured previously.

  # Remove 2 leading (tail -c +3) and 4 trailing (head -c -4)
  # characters (inner-quoted parenthetical):
  #   (' and ',)\n

  local windows_list_doubly_escaped
  windows_list_doubly_escaped="$(
    printf '%s\n' "${windows_list_parenquoted}" | head -c -4 | tail -c +3
  )"

  if [ -n "${RAISELOWER_TRACE_DIR}" ]; then
    echo "${windows_list_doubly_escaped}" > "${RAISELOWER_TRACE_DIR}/RLTRACE-02-WINSLIST_UNPACKED"
  fi

  local select_focus=""
  if ${_is_focused}; then
    select_focus="select(.focus == true) | "
  fi

  # Print matching window IDs.
  local windows_list_json="$(
    echo "${windows_list_doubly_escaped}" \
      | sed -e 's/\(\\\\\)\+\"/'"'"'/g' \
      | sed -e 's/\\"/"/g'
  )"
  if [ -n "${RAISELOWER_TRACE_DIR}" ]; then
    echo "${windows_list_json}" > "${RAISELOWER_TRACE_DIR}/RLTRACE-03-WINSLIST_DESCAPED"
  fi

  if ! echo "${windows_list_json}" \
    | jq ".[] | ${select_focus} .id" \
    ; then

    # SPIKE/DUNNO: What's an error indicate?
    # - No focused window? Or no windows at all?
    >&2 echo "DUNNO: Cannot determine $(
      ! ${_is_focused} || echo "focused "
    )windows ID(s) (window-calls)"
    >&2 echo "${windows_list_json}"

    return 1
  fi
}

get_focused_window_id_XWindow() {
  xdotool getactivewindow
}

# ***

raise_window() {
  local de_name="$1"
  shift

  if [ "${de_name}" = "GNOME" ]; then
    raise_window_Wayland "$@"
  elif [ "${de_name}" = "MATE" ]; then
    # BWARE/2025-09-09: Author has not tested X11 paths,
    # but I'd assume the 2 approaches here work the same.
    if ${RAISELOWER_WITH_WMCTRL:-false}; then
      raise_window_XWindow_wmctrl "$@"
    elif ${RAISELOWER_WITH_XDOTOOL:-true}; then
      raise_window_XWindow_xdotool "$@"
    fi
  fi
}

# CXREF: See similar gdbus calls:
#   _humb_print_terminal_window_title_prefixes_Wayland
# ~/.kit/sh/sh-humble-prompt/lib/show-command-name-in-window-title.sh
raise_window_Wayland() {
  local windows_ids
  if ! windows_ids="$(get_window_ids_Wayland ${_is_focused:-false})"; then

    return 1
  fi

  # Note if "'" in window title, then ("{\" ... \"}",) used
  # instead of ('{" ... "}',) — but we remove the outer
  # parentheses and outer quotes, so we can just remove the
  # escapes (otherwise jq won't be able to parse the blob).
  local windows_details
  windows_details="$(
    echo "${windows_ids}" \
      | xargs -I{} \
        gdbus call --session --dest org.gnome.Shell \
        --object-path /org/gnome/Shell/Extensions/Windows \
        --method org.gnome.Shell.Extensions.Windows.Details \
        {} 2> /dev/null \
      | sed -e 's/\(\\\\\)\+\"/'"'"'/g' \
      | sed -e "s/\\\\'/'/g"
  )"

  if [ -n "${RAISELOWER_TRACE_DIR}" ]; then
    echo "${windows_details}" > "${RAISELOWER_TRACE_DIR}/RLTRACE-11-WINSIDS_DESCAPED"
  fi

  # SAVVY: If window title contains single quotes, gdbus
  # escapes all the double quotes. Or something like that.
  # Which the sed removes.
  #
  # For complex window titles, e.g., if you copy-paste this code
  # into a terminal, and that terminal window title (PS4) is wired
  # to show the command being run, you might see delimited output.
  # I.e., because you're running the command in the terminal, and
  # because the terminal changes the window title to show the
  # command, you'll see the command you pasted in the list of
  # window titles, but it'll be escaped, e.g., something like this:
  #   ("{\"in_current_workspace\":true,...,\"title\":\"6. windows_details=
  #     \\\"$(echo \\\"${windows_list}\\\" | head -c -4 | tail -c +3
  #     | jq '.[] | .id' | xargs -I{} gdbus call ..., \"canshade\":false}",)
  # As opposed to how `gdbus` prints output if it doesn't need to
  # be escaped, e.g.:
  #   ('{"in_current_workspace":true,...,"title":"4. dconf watch /",
  #     ...,"canshade":false}',)
  # And when the former, delimited text is unpacked by gawk and
  # sed-substituted w/ 's/\\"/"/g' only, you might see, e.g.,:
  #   {"in_current_workspace":true,...,"title":"6. windows_details=
  #     \\"$(echo \\"${windows_list}\\" | head -c -4 | tail -c +3
  #     | jq '.[] | .id' | xargs -I{} gdbus call ...,"canshade":false}
  # But when fed through the jq filter, e.g.,
  #   ... | jq -r '"\(.title)\t\(.id)"'
  # that line causes an error, e.g.,
  #   parse error: Invalid numeric literal at line 9, column 258
  # So in addition to \" -> " also convert \\" -> \" (or at least WFM).

  # Note if the window title uses single-quotes, then window-calls changes
  # the output format and uses ({" ... }",) instead of ('{ ... }',). It
  # also uses escaped-double-quotes \" inside the value strings, which we
  # need to remove so that `jq` can parse the struct.

  local title_and_ids
  # Remove ('{ and }',) or ("{ and }",) from each line with gawk-match.
  title_and_ids="$(
    printf "%s" "${windows_details}" \
      | gawk 'match($0, /\{.*\}/, a) {print a[0]}' \
      | sed -e 's/\\\"//g' \
      | jq -r '"\(.title)\t\(.id)"' \
        2> /dev/null
  )"
  if [ $? -ne 0 ]; then
    if ${RAISELOWER_DEBUG:-false}; then
      >&2 echo "ERROR: Failed to parse window_details (1)"
      >&2 echo "${windows_details}"
    fi
    # DEBUG: If you get a parse error with a line number, e.g.,
    #   parse error: Invalid numeric literal at line 20, column 297
    # Then run with trace:
    #   RAISELOWER_DEBUG=true ...
    # And run the captured output manually (which will also make
    # the culprit line more apparent), e.g.,
    #   RAISELOWER_DEBUG=true \
    #     ~/.kit/sh/gvim-open-kindness/bin/raise-lower-desktop-window \
    #       {term} > windows_details
    #   cat windows_details | gawk ...

    title_and_ids="$(
      echo "${windows_details}" \
        | gawk 'match($0, /\{.*\}/, a) {print a[0]}' \
        | sed -e 's/\\"/"/g' -e 's/\\\\"/\\"/g' \
        | jq -r '"\(.title)\t\(.id)"'
    )"
    if [ $? -ne 0 ]; then
      >&2 echo "ERROR: Failed to parse window_details (2)"
      if ${RAISELOWER_DEBUG:-false}; then
        >&2 echo "${windows_details}"
      fi

      return 1
    fi
  fi

  local window_id

  local pattern
  for pattern in "$@"; do
    local title_and_id
    # Use Perl regex, or \t doesn't work (though literal "${pattern}.*	"
    # works, but not "${pattern}.*"$'\t', which is a Bashism anyway).
    title_and_id="$(
      echo "${title_and_ids}" | grep -P -e "${pattern}.*\t" | head -n1
    )"

    if [ -n "${title_and_id}" ]; then
      window_id="$(echo "${title_and_id}" | sed 's/.*\t//')"

      break
    fi
  done

  if [ -n "${window_id}" ]; then
    # DUNNO/2025-09-09: In GNOME Shell, prints "()" line to stdout.
    #   >&2 echo "window_id: ${window_id}"
    gdbus call --session --dest org.gnome.Shell \
      --object-path /org/gnome/Shell/Extensions/Windows \
      --method org.gnome.Shell.Extensions.Windows.Activate \
      -- "${window_id}" > /dev/null
  else
    >&2 echo "ALERT: No matching window identified for: $@"

    return 1
  fi
}

raise_window_XWindow_wmctrl() {
  local found_window=false

  local pattern
  for pattern in "$@"; do
    if wmctrl -a "${pattern}"; then
      found_window=true

      break
    fi
  done

  if ! ${found_window}; then

    return 1
  fi
}

raise_window_XWindow_xdotool() {
  if ! command -v xdotool > /dev/null; then
    >&2 echo "ERROR: Missing xdotool"

    return 1
  fi

  # On Linux, or at least Linux Mint MATE, gVim doesn't front on its
  # own. So go grab it.
  # - Note that xdotool (for me) spits out an error message:
  #     XGetWindowProperty[_NET_WM_DESKTOP] failed (code=1)
  #   but it works nonetheless, so chuck the error.
  local pattern
  for pattern in "$@"; do
    xdotool search --name "${pattern}" windowactivate > /dev/null 2>&1
  done
}

# ***

minimize_window() {
  local de_name="$1"
  shift

  if [ "${de_name}" = "GNOME" ]; then
    minimize_window_Wayland "$@"
  elif [ "${de_name}" = "MATE" ]; then
    minimize_window_XWindow "$@"
  fi
}

minimize_window_Wayland() {
  local window_id="$1"

  # OUTPUTs: ()
  gdbus call --session --dest org.gnome.Shell \
    --object-path /org/gnome/Shell/Extensions/Windows \
    --method org.gnome.Shell.Extensions.Windows.Minimize \
    -- "${window_id}" > /dev/null
}

minimize_window_XWindow() {
  local window_id="$1"

  xdotool windowminimize "${window_id}"
}

# ***

# COPYD/2025-09-09: From sh-humble-prompt:
#   _humb_probe_desktop_environment
#     https://github.com/DepoXy/sh-humble-prompt#🙇
# - CXREF: For DepoXy users, at:
#   ~/.kit/sh/sh-humble-prompt/lib/show-command-name-in-window-title.sh
_humb_probe_desktop_environment() {
  # Colon-separated list, uppercased.
  local currdes
  currdes="$(echo "${XDG_CURRENT_DESKTOP}" | tr '[:lower:]' '[:upper:]')"

  (
    IFS=:
    for denv in ${currdes}; do
      if [ "${denv}" = "GNOME" ]; then
        echo "GNOME"
      elif [ "${denv}" = "MATE" ]; then
        echo "MATE"
      else

        continue
      fi

      break
    done
  )
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# REFER: https://github.com/DepoXy/macOS-Hammyspoony#🥄
# https://github.com/DepoXy/macOS-Hammyspoony/blob/release/Source/URISetFrontmost.spoon/init.lua

toggle_window_focus_macos() {
  local pattern="$1"

  open -g "hammerspoon://setFrontmost?name=${server_id}" \
    2> /dev/null \
    || true
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

os_is_linux() {
  [ "$(uname)" = "Linux" ]
}

os_is_macos() {
  [ "$(uname)" = "Darwin" ]
}

check_deps() {
  if os_is_linux; then
    if [ "${de_name}" = "GNOME" ]; then
      check_deps_wayland
    elif [ "${de_name}" = "MATE" ]; then
      check_deps_xwindow
    fi
  elif os_is_macos; then
    check_deps_darwin
  else
    >&2 echo "ERROR: This script only runs on Linux or macOS"

    return 1
  fi
}

check_deps_wayland() {
  # FIXME/2025-01-14: Just guessing here. There might be a
  # more proper way to check if an Extension is installed.
  # - Perhaps failing on the call is good enough, see: raise_window_Wayland
  if ! [ -d "${HOME}/.local/share/gnome-shell/extensions/window-calls@domandoman.xyz" ]; then
    alert_missing_gnome_extension_window_calls

    return 1
  fi
}

alert_missing_gnome_extension_window_calls() {
  >&2 echo "ERROR: Missing GNOME Extension: window-calls"
  >&2 echo "  https://extensions.gnome.org/extension/4724/window-calls/"
  >&2 echo "  https://github.com/ickyicky/window-calls"
}

check_deps_xwindow() {
  if ! command -v wmctrl > /dev/null; then
    >&2 echo "ERROR: Missing comand \`wmctrl\`"

    return 1
  fi

  if ! command -v xdotool > /dev/null; then
    >&2 echo "ERROR: Missing comand \`xdotool\`"

    return 1
  fi
}

# OPTIN: macOS-Hammyspoony has a Spoon that'll toggle window viz & frontiness:
# https://github.com/DepoXy/macOS-Hammyspoony/blob/release/Source/URISetFrontmost.spoon/init.lua
check_deps_darwin() {
  :
}

# ***

main() {
  if [ -z "$1" ]; then
    >&2 echo "USAGE: $0 {window title}"

    return 1
  fi

  local de_name
  de_name="$(_humb_probe_desktop_environment)"

  if ! check_deps; then

    return 1
  fi

  toggle_window_focus "$@"
}

# ***

_vimokbrldw_this_file_name="raise-lower-desktop-window"
_vimokbrldw_canonical_comm="$(basename -- "$(realpath -- "$0")")"
_vimokbrldw_shell_sourced() {
  [ "${_vimokbrldw_canonical_comm}" != "${_vimokbrldw_this_file_name}" ]
}

if _vimokbrldw_shell_sourced; then
  unset -f main
  unset -v _vimokbrldw_this_file_name
  unset -f _vimokbrldw_shell_sourc
else
  main "$@"
fi
