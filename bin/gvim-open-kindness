# This usage is not actually displayed.
gvim_open_kindness_print_usage () {
  echo 'USAGE: `gvim-open-kindness` <servername> <line> <column> <path>...'
  echo '       `nvim-open-kindness` <socketname> <line> <column> <path>...'
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# HINT: If calling from Karabiner-Elements on macOS, ensure errors
#       can be reported easily via desktop notifications:
#
#         brew install terminal-notifier
#
#       Otherwise any error will be written to a temp file.
#       You can find the most recent such file thusly:
#
#         ls -rt /tmp | grep 'gvim-open-kindness' | tail -1

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# By default, this script uses the same servername or socketname when
# it's called, so that files are opened in the same editor instance.

# USAGE: Customize Vim --servername (optional), which you may see in
#        the Vim titlebar.
#
# - On Linux (X11), the servername should be unique enough that
#   xdotool can identify the gVim window by its name.
#
#   - On macOS, there's no xdotool, but also MacVim brings itself to
#     front by default. You'll still see the servername in the title-
#     bar.
#
# SAVVY: Pro tip: You can use emojis, e.g.,:
#
#     GVIM_OPEN_SERVERNAME="${GVIM_OPEN_SERVERNAME:-🖤}"
#
#   which can be used to ensure that the servername is not only
#   unique, but "fun".
#
# USAGE: Personalize the server name, which appears in the Vim title bar.

GVIM_OPEN_SERVERNAME="${GVIM_OPEN_SERVERNAME:-GVIM}"

# USAGE: Customize Neovim --server socket name postfix (optional),
#        which you might add to the Neovim titlebar title so that
#        you can easity find and front nvim terminal windows.
#
# - On Neovim, the socketname is used to create a socket that Neovim uses
#   to communicate amongst itself. However, Neovim doesn't show the socket
#   name in the window titlebar by default, so you may not care to customize
#   this value.
#
#   - Though if you use the vim-title-bar-time-of-day plugin, you might care:
#
#       https://github.com/landonb/vim-title-bar-time-of-day#🕰️
#
#     That plugin prints the socket name postfix to the Vim title bar
#     so that this script can find and front the window when the user
#     is running nvim in a terminal window.
#
#     (If user is instead running a GUI, e.g., Neovide, this script
#      will call the `open` command, e.g., `open -a neovide`. But if
#      user is running nvim in a terminal, and if they have multiple
#      terminal windows open, `open` won't help. So this script uses
#      a Hammerspoon Spoon instead to find and front the window:
#
#         https://github.com/DepoXy/macOS-Hammyspoony#🥄
#
#       https://github.com/DepoXy/macOS-Hammyspoony/blob/release/Source/URISetFrontmost.spoon/init.lua
#
#      See the `open -g "hammerspoon://..."` call, below.)
#
#   - So feel free to customize this value, especially if you use the
#     server name in the window title.

NVIM_OPEN_SOCKETNAME="${NVIM_OPEN_SOCKETNAME:-NVIM}"

# USAGE: Specify the command to call when starting a new nvim server.
# - When opening a file in an existing nvim instance, this script calls
#   `nvim` to communicate with it. But if the server is not yet running,
#   this script runs this command to start a new editor instance.
# - Note (#aside) that Neovide doesn't front itself automatically, so this
#   script calls `open -a {app}` to ensure the chosen editor is fronted.
#   - Or if nvim is target app, then this script uses hammerspoon:// URI;
#     see previous comment.
# - UPICK: Some nvim TUIs or GUIs you might entertain:
#   - Neovim  — https://neovim.io/  # Neovim itself, in a terminal
#   - Neovide — https://neovide.dev
#   - VimR    — https://github.com/qvacua/vimr
#   - envim   — https://github.com/tk-shirasaka/envim
#   - vv      — https://github.com/vv-vim/vv
#
#   NVIM_OPEN_APPNAME="${NVIM_OPEN_APPNAME:-nvim}"
#   NVIM_OPEN_APPNAME="${NVIM_OPEN_APPNAME:-neovide}"
#   etc.

NVIM_OPEN_APPNAME="${NVIM_OPEN_APPNAME:-nvim}"

# USAGE: When starting new instance, use specific `.../bin/nvim` path.
# - If unset, uses `nvim` on PATH.
# - This settings applies to either terminal nvim or Neovide.
# - REFER: From `neovide --help`:
#     --neovim-bin <NEOVIM_BIN>
#       ... env: NEOVIM_BIN=/opt/homebrew/bin/nvim

NEOVIM_BIN="${NEOVIM_BIN}"

# USAGE: Enable always running GVim or Neovim.
# - Set one of these environs to always use gvim or nvim, regardless of $0.
# - If both are 'true', this scripts uses nvim.
# - If neither are 'true', this script picks gvim or nvim by checking
#   whether user invoked `gvim-open-kindness` or `nvim-open-kindness`.

GVIM_OPEN_PREFER_GVIM=${GVIM_OPEN_PREFER_GVIM:-false}
GVIM_OPEN_PREFER_NVIM=${GVIM_OPEN_PREFER_NVIM:-false}

# USAGE: Set or use this environ to add the `vim -u <vimrc>` option
# when initiating a new Vim/Neovim instance.

GVIM_OPEN_INIT_VIMRC="${GVIM_OPEN_INIT_VIMRC}"

# USAGE: Pick a default behavior when the editor is launched for the
# first time and no file(s) are specified:
# - Do nothing special; let Vim start normally.
#   - Same as:
#     unset -v GVIM_OPEN_FILE_ON_SPAWN
#     # OR:
#     GVIM_OPEN_FILE_ON_SPAWN=""
# - Open a specific file, e.g., ~/README.rst
#   - E.g.,
#     GVIM_OPEN_FILE_ON_SPAWN="${HOME}/README.rst"
# - Configure a scratch buffer (that disappears when it's unloaded
#   from all windows unless the user saves it; unlike normal Vim
#   startup that creates a [No Name] buffer that user has to
#   explicitly close if they don't want it).
#   - Use the special keyword "[Scratch]", e.g.,
#     GVIM_OPEN_FILE_ON_SPAWN="[Scratch]"
# SAVVY: These do not apply when the editor is already running;
# in that case, the specified file(s) will be opened in the
# current instance. Or, if no file(s) are specified, the editor
# will simply be fronted.
# USAGE: You can use either GVIM_ or NVIM_ variation, your pick.
# - Internally, we use the NVIM_-prefixed variants.

NVIM_OPEN_FILE_ON_SPAWN="${NVIM_OPEN_FILE_ON_SPAWN:-${GVIM_OPEN_FILE_ON_SPAWN}}"

# USAGE: Magic NVIM_OPEN_FILE_ON_SPAWN you can use to start (n)vim
# with scratch buffer when spawning new instance and no file paths
# specified.

NVIM_SPAWN_OPTION_SCRATCH="[Scratch]"

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

source_deps () {
  source_dep_homebrew
}

source_dep_homebrew () {
  [ -n "${HOMEBREW_PREFIX}" ] || return 0

  local brew_path="$(print_homebrew_path)"

  [ -x "${brew_path}" ] || return 0

  eval "$(${brew_path} shellenv)"
}

# USYNC: See DXY's `_depoxy_print_homebrew_path`:
#   https://github.com/DepoXy/depoxy#🍯
#     ~/.depoxy/ambers/core/brewskies.sh
#   https://github.com/DepoXy/depoxy/tree/HEAD/core/brewskies.sh
print_homebrew_path () {
  local brew_path=""

  # On Apple Silicon (arm64/AArch64) Macs (M1, M2, etc.) it's /opt/homebrew
  # - ALTLY: [ "$(uname -m)" = "arm64" ]
  [ -x "${brew_path}" ] || brew_path="/opt/homebrew/bin/brew"

  # On Intel Macs it's under /usr/local (tho deprecated)
  [ -x "${brew_path}" ] || brew_path="/usr/local/bin/brew"

  # On Linux, it's under /home (although there's no 'linuxbrew' account)
  # - Skip on Linux (on macOS, MacVim generally installed via Homebrew;
  #   but on Linux, author assumes most users get Vim from distro repo).
  # - INERT: We could check first if we need to engage Homebrew. But for
  #   now we'll just assume all macOS users need Homebrew to run MacVim.
  #
  #  [ -x "${brew_path}" ] || brew_path="/home/linuxbrew/.linuxbrew/bin/brew"

  [ -x "${brew_path}" ] || brew_path=""

  printf "%s" "${brew_path}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

gvim_open_kindness () {
  local server_id
  local row_number
  local col_number

  # USAGE/2025-02-03: This is script meant to be called via tooling, and
  # not directly, so caller can specify a server ID, and rol and column,
  # followed by variadic args (one or more file paths).
  # - HSTRY: From 2021-08-19 to now, the arg parser would assume if any
  #   argument is a valid file path, user chose not to bother specifing
  #   all non-file parameters, so that user could run this script from
  #   CLI.
  #   - E.g., `gvim-open-kindness foo` would interpret 'foo' as file if
  #     'foo' exists, otherwise it would use 'foo' as server/socket ID.
  #   - But UX is bad if 'foo' is not a file, but user assumes it is,
  #     because then script opens a *new* editor instance (using 'foo' as
  #     its server/socket ID). But it's not obvious to user what happened.
  #   - So now it's recommeded you make an alias to this script instead,
  #     e.g.,
  #       # Use `fs` to edit file(s) using default server/socket ID.
  #       alias fs="gvim-open-kindness '' '' ''"
  #       # Use `fa` to edit file(s) in a seperate editor instance.
  #       alias fa="gvim-open-kindness '🐬' '' ''"
  if [ -n "${1+x}" ] && [ "$1" != "--" ]; then server_id="$1"; shift; fi
  if [ -n "${1+x}" ] && [ "$1" != "--" ]; then row_number="$1"; shift; fi
  if [ -n "${1+x}" ] && [ "$1" != "--" ]; then col_number="$1"; shift; fi
  if [ "$1" = "--" ]; then shift; fi

  adjust_gvim_or_nvim_per_user_pref_environ

  must_locate_executable_or_notify_and_exit

  local socket_path=""
  local server_arg=""
  local is_server_running=true
  gvim_ensure_server_id_or_use_default "${server_id}"

  gvim_relocate_cursor_to_editing_window "${server_arg}"

  gvim_open_files "${server_arg}" "${socket_path}" "${row_number}" "${col_number}" "$@"

  gvim_bring_window_to_front "${server_id}"
}

# ***

# This script picked GVIM or NVIM based on executable user ran
# (`gvim-open-kindness` vs. `nvim-open-kindness`) but user can
# override/force a preference using GVIM_OPEN_PREFER_* environ.
adjust_gvim_or_nvim_per_user_pref_environ () {
  if ${GVIM_OPEN_PREFER_GVIM:-false}; then
    GVIM_OPEN_EDITOR="GVIM"
  fi

  if ${GVIM_OPEN_PREFER_NVIM:-false}; then
    GVIM_OPEN_EDITOR="NVIM"
  fi
}

is_editor_gvim () {
  test "${GVIM_OPEN_EDITOR:-GVIM}" = "GVIM"
}

gvim_procname () {
  if is_editor_gvim; then
    # Runs MacVim on macOS.
    printf "%s" "gvim"
  else
    # Use nvim to communicate with NVIM_OPEN_APPNAME instance.
    printf "%s" "nvim"
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# Prepare PATH so this script can call `gvim` without a full path.
#
# When this script is used by a Keyboard Shortcut, only a basic shell
# is initialized, and `gvim` might not be found on the default PATH.
#
# - E.g., when Karabiner-Elements (macOS) calls this script, the PATH
#   is very simple: /usr/bin:/bin:/usr/sbin:/sbin.
#
#   But Home Brew installs MacVim to /usr/local/bin (older Intel Macs),
#   or to /opt/homebrew/bin (newer arm64 Apple Silicon), which is not on
#   PATH by default.
#
# - On MATE (at least this is the PATH that I see; I'm not sure if it's
#   common to include ~/.local/bin), a mate-panel launcher PATH reports:
#     /home/user/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:
#       /usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin

must_locate_executable_or_notify_and_exit () {
  PATH="/usr/local/bin:${PATH}"

  # Aka ${HOMEBREW_PREFIX}
  local brew_home="/opt/homebrew"
  # Otherwise on Intel Macs it's under /usr/local.
  [ -d "${brew_home}" ] || brew_home="/usr/local"
  #
  if [ -d "${brew_home}" ]; then
    # Support Karabiner-Elements with MacVim at brew-installed location;
    # also to find `terminal-notifier`.
    PATH="${brew_home}/bin:${PATH}"
  fi

  # Support Linux users with custom build at conventional location.
  PATH="${HOME}/.local/bin:${PATH}"

  must_verify_command "$(gvim_procname)"

  if ! is_editor_gvim; then
    if [ "${NVIM_OPEN_APPNAME}" != "neovide" ] \
      && [ "${NVIM_OPEN_APPNAME}" != "nvim" ] \
    ; then
      # USAGE: Add new editor support to gvim_open_files, below.
      >&2 echo "ERROR: Unrecognized Neovim app: ${NVIM_OPEN_APPNAME}"

      exit_1
    fi

    must_verify_command "${NVIM_OPEN_APPNAME}"

    if [ -n "${NEOVIM_BIN}" ]; then
      must_verify_command "${NEOVIM_BIN}"
    fi
  fi
}

must_verify_command () {
  local cmd="$1"

  if ! type "${cmd}" > /dev/null 2>&1; then
    stderr_or_desktop_notify "gvim-open-kindness" "Where's ${cmd}?"

    exit_1
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# In case of trouble, try notifying user via desktop notification.
#
# Because this script is used in contexts (OS Keyboard Shortcuts)
# where we cannot communicate with the user how we normally might
# (e.g., stdout or stderr), try using a desktop notification.
#
# - On Linux, we can look for notify-send, which is pretty standard.
#
# - On macOS, we can look for terminal-notifier, which is just a nice
#   project I found that the user needs to (brew-)install themselves.
#
# - (And I dunno how useful this is, but at least it's something:)
#   If neither desktop notifier found, dump the message to a temporary
#   file. Not that non-developer users will know to look there (unless
#   we document it), but at least if anyone asks, we'll have something
#   to suggest which is easy to do.
#
#   - Note that on Linux, `mktemp` generally uses /tmp, but on macOS
#     you'll see a different path, e.g.,
#
#       @macOS $ mktemp
#       /var/folders/cs/h762zc8951zdm1ycc_2zqwb9l60wrb/T
#
#       @macOS $ echo $TMPDIR
#       /var/folders/cs/h762zc8951zdm1ycc_2zqwb9l60wrb/T/      
#
#     But there's still a /tmp directory nonetheless:
#
#       @macOS $ ll /tmp
#       /tmp -> private/tmp
#
#     And thankfully the `mktemp` command lets us use that path (which
#     simplifies troubleshooting, otherwise we would need to tell the
#     user to look under $TMPDIR; seems easier to just tell 'em /tmp):
#
#       @macOS $ mktemp /tmp/HELLO.XXXXXX
#       /tmp/HELLO.3vkABm
#
# - CAVEAT: In my experience, notify-send does nothing when passed
#   a long string, e.g., from my terminal, this does nothing:
#
#     notify-send "PATH=$PATH"
#
#   but it works if I trucate it:
#
#     notify-send "PATH=$(expr substr "${PATH}" 1 200)"

stderr_or_desktop_notify () {
  stdout_isatty () { [ -t 1 ]; }

  if stdout_isatty; then
    >&2 echo "ERROR: $@"
  else
    desktop_notify "$@"
  fi
}

desktop_notify () {
  local summary="$1"
  local body="$2"

  if command -v notify-send > /dev/null; then
    # Linux
    notify-send "${summary}" "${body}"
  elif command -v terminal-notifier > /dev/null; then
    # macOS — e.g., /opt/homebrew/bin/terminal-notifier
    #  Or /usr/local/bin/terminal-notifier
    # - Without -title, prints "Terminal".
    #   With -title "", prints "terminal-notifier".
    #   Note -subtitle is second line, bolded, and -message
    #   is third line, not bolded; only -message is required.
    terminal-notifier -message "${body}" -title "${summary}"
  else
    # Undesirable branch.

    local tempfile
    tempfile="$(mktemp /tmp/$(basename -- "$0").XXXXXX)" || exit_1

    echo "ERROR: ${summary}: ${body}" >> "${tempfile}"
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# REFER: How to communicate with nvim server:
# https://neovim.io/doc/user/api.html#RPC
# https://neovim.io/doc/user/builtin.html#serverstart()

# `local` vars. set for caller:
#  local server_id
#  local server_arg
#  local socket_path
#  local is_server_running
gvim_ensure_server_id_or_use_default () {
  local server_id_arg="$1"

  server_id="${server_id_arg}"
  socket_path=""
  server_arg=""
  is_server_running=false

  if is_editor_gvim; then
    if [ -z "${server_id}" ]; then
      server_id="${GVIM_OPEN_SERVERNAME:-GVIM}"
    fi
    server_arg="--servername ${server_id}"
    # If user ran bare `gvim-open-kindness` without file paths, it matters
    # if gvim already running or not:
    # - `gvim --servername {}` *always* starts a new instance (e.g., MacVim);
    #   and
    # - `gvim --servername {} --remote-send ...` fails without at least one
    #   path arg.
    # - This `ps | grep` suss feels a little *V. Hacky*.
    #   - It works with at least MacVim.
    #     - SPIKE/2025-02-06: Verify on Linux.
    # - On macOS, MacVim process output looks like:
    #     .../MacVim.app/Contents/MacOS/Vim -f -g --servername GVIM --remote-silent file/path
    if ps aux | grep -i -e "vim .*\--servername" | grep -v grep > /dev/null; then
      is_server_running=true
    fi
  else
    if [ -z "${server_id}" ]; then
      server_id="${NVIM_OPEN_SOCKETNAME:-NVIM}"
    fi
    socket_path="/tmp/nvim.socket-${server_id}"
    # This won't work unless we `eval` the command later:
    #   server_arg="--server \"${socket_path}\""
    server_arg="--server ${socket_path}"
    is_server_running=$(test -S ${socket_path} && echo true || echo false)
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# REFER/2024-12-15: Calls (optional) FocusCursorInNormalBufferWindow in
#   https://github.com/embrace-vim/vim-buffer-delights#🍧
# ~/.kit/nvim/embrace-vim/start/vim-buffer-delights/autoload/embrace/windows.vim

# Adjust the Vim cursor before opening the file, if necessary, so
# the new buffer does not replace the quickfix buffer, an open help
# file, or the project tray, etc.
#
# Note that `man gvim` says --cmd is 'executed just before processing
# any vimrc', but that doesn't mean it runs before the file is loaded.
# Or even after, as far as I could tell (doesn't seem to run at all).
#
# - So sending keystrokes to invoke command via --remote-send.
#
# Also, --remote-send fails if the server is not started, e.g.,
#   E247: no registered server named "GVIM": Send failed.
# so toss the stderr stream.
#
# Finally, use `silent!` to ignore error if autoload/ fcn. absent. 

gvim_relocate_cursor_to_editing_window () {
  local server_arg="$1"

  if ! ${is_server_running}; then

    return
  fi

  # If gvim not running, e.g.:
  #   E247: No registered server named "GVIM": Send failed.

  # MAYBE/2025-01-24: If is_server_running, nvim shouldn't generate any output,
  # so we could remove the stream inhibitors. Though if it fails, it might be
  # a lot of garbage output.

  # BUGGY/2025-01-29: This would be a *FIXEM*, but I doubt there's a good fix.
  # - Both calls to --remote-send (see also :cursor call below) must <ESC>
  #   just in case user is in Insert mode.
  #   - But then we have to leave user in Normal mode, because there's no
  #     way to know the state before the --remote-send!
  #     - Maybe: Is there a single character you could send, like send `i`,
  #       then <ESC> and run a command — and if that command sees that an
  #       'i' was just inserted into the buffer, remove it, and assume user
  #       was previously in Insert mode.
  #       - Although how do you know who created the 'i'? Is there a timestamp
  #         for the last edit, maybe the undo knows? I don't think you can tell,
  #         I was just spitballing ideas... cuz I don't know it there's a sol'n
  #         to this dilemma at all. You cannot use gvim-open-kindness and remain
  #         in Insert mode =(.

  $(gvim_procname) \
    ${server_arg} \
    --remote-send "<ESC>:silent! call g:embrace#windows#FocusCursorInNormalBufferWindow()<CR>" \
    > /dev/null 2>&1 \
    || is_server_running=false
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# Send gvim outputs to null, aka the bit bucket, black hole, null route,
# punch (card) bucket, or possibly most technically the null device.
#
# DUNNO/2024-10-18: On macOS, you might otherwise see spew going to
# whatever terminal opened gvim, e.g.:
#
#   Vim(55510) MallocStackLogging: can't turn off malloc stack logging because it was not enabled.
#   Vim(55514) MallocStackLogging: can't turn off malloc stack logging because it was not enabled.
#   Vim(55518) MallocStackLogging: can't turn off malloc stack logging because it was not enabled.
#   ...

# BWARE: Don't run without a path argument.
# - E.g., suppose an editor is alreaady running:
#   - We can have it open a file with a command like this:
#       nvim --server /tmp/nvim.socket-ALPHA --remote-silent ~/README.rst
#   - But if we omit the path, it looks like nvim tries to start
#     in the terminal, it spews some output, then dies with a
#     message like this:
#       Error executing lua: Vim:Error invoking 'nvim_command' on channel 3:
#         Vim(drop):E471: Argument required: drop
#           stack traceback:
#             [C]: in function 'rpcrequest'
#               vim/_editor.lua: in function <vim/_editor.lua:0>
# - So skip this step unless opening files.
#   - Though note that opening a file in MacVim fronts it, but
#     `--remote-silent` requires a path argument. So if we don't
#     have a path to open, we need to front MacVim differently
#     (see gvim_bring_window_to_front) which currently requires
#     an external tool (Hammerspoon, and Hammyspoony).

gvim_open_files () {
  local server_arg="$1"
  local socket_path="$2"
  local row_number="$3"
  local col_number="${4:-0}"
  shift 4

  # DUNNO: Relative paths don't work with nvim, apparently:
  #   cd ~/path/to/gvim-open-kindness
  #   nvim --server /tmp/neovide.socket --remote-silent bin/nvim-open-kindness
  # Opens the file: ~/bin/nvim-open-kindness

  local cursor_cmd=""
  local cursor_send=""
  if [ -n "${row_number}" ] && [ -n "${col_number}" ]; then
    # The cursor_cmd applies to new instances.
    cursor_cmd="-c 'call cursor(${row_number}, ${col_number})'"
    # The cursor_send applies to existing instances.
    cursor_send="--remote-send '<ESC>:call cursor(${row_number}, ${col_number})<CR>'"
  fi

  local scratch_cmd=""
  if ! ${is_server_running} && [ $# -eq 0 ]; then
    if [ "${NVIM_OPEN_FILE_ON_SPAWN}" = "${NVIM_SPAWN_OPTION_SCRATCH}" ]; then
      # REFER: |scratch-buffer|, etc.
      scratch_cmd="-c 'setlocal buftype=nofile bufhidden=wipe noswapfile nobuflisted'"
    elif [ -n "${NVIM_OPEN_FILE_ON_SPAWN}" ]; then
      set -- "${NVIM_OPEN_FILE_ON_SPAWN}"
    fi
  fi

  local vimrc_cmd=""
  if [ -n "${GVIM_OPEN_INIT_VIMRC}" ]; then
    vimrc_cmd="-u \"${GVIM_OPEN_INIT_VIMRC}\""
  fi

  if ! ${is_server_running} && ! is_editor_gvim; then
    # Start user's preferred Neovim GUI, e.g., Neovide.
    if [ "${NVIM_OPEN_APPNAME}" = "neovide" ]; then
      # DUNNO: Doesn't work: `NEOVIM_BIN=.../path/to/nvim neovide ...`
      local neovim_bin=""
      if [ -n "${NEOVIM_BIN}" ]; then
        neovim_bin="--neovim-bin \"${NEOVIM_BIN}\""
      fi
      eval "neovide ${neovim_bin} -- --listen ${socket_path} ${vimrc_cmd} ${cursor_cmd} ${scratch_cmd} $@ & 2>/dev/null"
    elif [ "${NVIM_OPEN_APPNAME}" = "nvim" ]; then
      # Run nvim in the terminal until user quits it.
      eval "${NEOVIM_BIN:-nvim} --listen ${socket_path} ${vimrc_cmd} ${cursor_cmd} ${scratch_cmd} $@"

      exit_0
    fi
    # else, Unreachable path
  else
    # The Neovim instance is already running, or this is GVim
    # (which may or may not be running).
    # - BUGGY: See command above re: --remote-send leaves user in Normal
    #   mode, even if they were in Insert mode (and we prob. cannot fix).
    local cursor_arg=""
    if is_editor_gvim; then
      cursor_arg="${cursor_cmd}"
    else
      cursor_arg="${cursor_send}"
    fi

    if is_editor_gvim; then
      # Note that `--remote-silent` works whether or not the editor is
      # already running (so long as it's followed by path arg(s)).
      local remote_silent=""
      if [ $# -gt 0 ]; then
        remote_silent="--remote-silent"
      fi

      if [ $# -gt 0 ] || ! ${is_server_running}; then
        eval "$(gvim_procname) \
          ${server_arg} \
          ${cursor_arg} \
          ${scratch_cmd} \
          ${remote_silent} \
          $(expand_paths "$@") \
          2>/dev/null"
      else
        eval "$(gvim_procname) \
          ${server_arg} \
          ${cursor_send} \
          2>/dev/null"
      fi
      # else, not sending server an rpc comand, because no file(s) specified.
      # - See next: gvim_bring_window_to_front will front the window.
    # BWARE: Don't run without a path argument.
    # - See comment above, before function.
    else
      if [ $# -gt 0 ]; then
        # Send path args and cursor command to Neovim instance.
        eval "$(gvim_procname) \
          ${server_arg} \
          --remote-silent \
          $(expand_paths "$@") \
          2>/dev/null"
      fi
      if [ -n "${cursor_arg}" ]; then
        # Without the eval, opens file, but when user presses any key,
        # cursor jumps to command line which has `:call cursor(X, X)`
        # printed. TL_DR: <CR> in var. doesn't work without the eval.
        eval "$(gvim_procname) \
          ${server_arg} \
          ${cursor_arg} \
          2>/dev/null"
      fi
    fi
  fi
}

# Returns a list of path arguments to use in an `eval`.
# - Resolve paths (open canonical file, not symlink path), or falls-
#   back on the unaltered path if absent; escapes any double-quotes
#   in the file path (an edge case), double-quote the result, and
#   convert the newline to a space.
expand_paths () {
  for path in "$@"; do
    printf "${path}\0"
  done \
    | xargs -I{} -0 sh -c 'realpath -- "{}" 2> /dev/null || echo "{}"' \
    | $(command -v gsed || command -v sed) 's/"/\\"/g' \
    | $(command -v gsed || command -v sed) 's/^\(.*\)$/"\1"/' \
    | tr "\n" " "
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# Bring gVim to front. This happens automatically on macOS.

# (lb): I didn't enable this for Linux until I saw the behavior in macOS.
# Because it's more often than not that I want to use Vim after opening a
# file in it, I enabled this behavior for X11.

# FTREQ/2025-01-25: Add Wayland path.
# - For now, xdotool may work if GVim uses Xwayland.

gvim_bring_window_to_front () {
  if ! os_is_macos; then
    gvim_bring_window_to_front_X "$@"
  else
    gvim_bring_window_to_front_macOS "$@"
  fi
}
  
gvim_bring_window_to_front_X () {
  local server_id="$1"

  if ! command -v xdotool >/dev/null; then

    return 0
  fi

  # On Linux, or at least Linux Mint MATE, gVim doesn't front on its
  # own. So go grab it.
  # - Note that xdotool (for me) spits out an error message:
  #     XGetWindowProperty[_NET_WM_DESKTOP] failed (code=1)
  #   but it works nonetheless, so chuck the error.
  xdotool search --name "${server_id}" windowactivate > /dev/null 2>&1
}
  
# REFER: Requires Hammyspoony Hammerspoon Spoon to front nvim TUI,
# or when more than one Neovide or GUI instance running:
#
#   https://github.com/DepoXy/macOS-Hammyspoony#🥄

gvim_bring_window_to_front_macOS () {
  local server_id="$1"

  if ! ${is_server_running}; then
    # Was fronted when the editor was started (and either
    # the GUI launched, or (n)vim was started in the terminal).

    return 0
  fi

  local is_single_gui_instance=false

  # MacVim fronts itself when you --remote-send it files to open,
  # but if there are no files (bare gvim-open-kindness, and MacVim
  # already running), then we need to front it here.
  #
  # For Neovide, `open -a neovide` works if there's only one instance,
  # otherwise we need to find and front it using its server ID.
  #
  # Likewise if running in the terminal, we need to find the window by
  # looking for the server ID.
  #
  # - MAYBE: The rest of this fcn. could be simplified to the
  #   last `open -g hammerspoon://setFrontmost` call.
  #   - The only difference is `open -a neovide` if there's only
  #     one neovide running, to support folx without Hammyspoony.

  if ! is_editor_gvim && [ "${NVIM_OPEN_APPNAME}" != "nvim" ]; then
    local n_instances
    n_instances="$(ps aux | grep -e "${NVIM_OPEN_APPNAME}" | grep -v grep | wc -l)"

    if [ ${n_instances} -eq 1 ]; then
      # E.g., just 1 "neovide" instance.
      is_single_gui_instance=true
    fi
    # else, there's no reason not to always call hammerspoon://setFrontmost —
    # and to never call `open -a` — but at least the `open -a` branch works
    # if the user is not running Hammyspoony.
  fi
  # else, running (n)vim in terminal, or running MacVim, in which case we
  # need to use setFrontmost to find the window by name — which depends on
  # user's (Neo)vim showing the server ID in the window title.

  if ${is_single_gui_instance}; then
    # E.g., "neovide"
    open -a "${NVIM_OPEN_APPNAME}" \
      || true
  else
    # FIXME/2025-02-06: When empty string, fronts what was hidden Activity Monitor.
    open -g "hammerspoon://setFrontmost?name=${server_id}" \
      2> /dev/null \
      || true
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

os_is_macos () {
  [ "$(uname)" = "Darwin" ]
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

clear_traps () {
  trap - EXIT INT
}

set_traps () {
  trap -- trap_exit EXIT
  trap -- trap_int INT
}

exit_0 () {
  clear_traps

  exit 0
}

exit_1 () {
  clear_traps

  exit 1
}

trap_exit () {
  clear_traps

  # USAGE: Alert on unexpected error path, so you can add happy path.
  >&2 echo "ALERT: "$(basename -- "$0")" exited abnormally!"
  >&2 echo "- Hint: Enable \`set -x\` and run again..."

  exit 2
}

trap_int () {
  clear_traps

  exit 3
}

# ***

SCRIPT_NAME_GVIM="gvim-open-kindness"
SCRIPT_NAME_NVIM="nvim-open-kindness"

main () {
  local proc_bname
  proc_bname="$(basename -- "$0")"

  local run_as=""

  # Run the function if being executed.
  # Otherwise being sourced, so do not.
  if [ "${proc_bname}" = "${SCRIPT_NAME_GVIM}" ]; then
    run_as="GVIM"
  elif [ "${proc_bname}" = "${SCRIPT_NAME_NVIM}" ]; then
    run_as="NVIM"
  else

    return
  fi

  # ***

  set -e

  set_traps

  # ***

  source_deps

  GVIM_OPEN_EDITOR=${GVIM_OPEN_EDITOR:-${run_as}}

  gvim_open_kindness "$@"

  # ***

  clear_traps
}

main "$@"

