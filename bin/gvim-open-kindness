# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# This usage is not actually displayed.
gvim_open_kindness_print_usage () {
  echo 'USAGE: `gvim-open-kindness` <servername> <line> <column> <path>...'
  echo '       `nvim-open-kindness` <socketname> <line> <column> <path>...'
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# HINT: If calling from Karabiner-Elements on macOS, ensure errors
#       can be reported easily via desktop notifications:
#
#         brew install terminal-notifier
#
#       Otherwise any error will be written to a temp file.
#       You can find the most recent such file thusly:
#
#         ls -rt /tmp | grep 'gvim-open-kindness' | tail -1

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# By default, this script uses the same servername or socketname when
# it's called, so that files are opened in the same editor instance.
# - On Linux (X11), the servername should be unique enough that
#   xdotool can identify the gVim window by its name.
# - On macOS, there's no xdotool, but also MacVim brings itself to
#   front by default, so there's nothing lacking, either.
# - Neovim uses a socket to communicate and doesn't show that name
#   in the window titlebar.
#
# USAGE: Personalize the server name, which appears in the Vim title bar.
GVIM_OPEN_SERVERNAME="${GVIM_OPEN_SERVERNAME:-GVIM}"
# - Pro tip: You can use emojis, e.g.,:
#
#   GVIM_OPEN_SERVERNAME="${GVIM_OPEN_SERVERNAME:-🖤}"

# You won't see this name anywhere, 
NVIM_OPEN_SOCKETNAME="${NVIM_OPEN_SOCKETNAME:-NVIM}"

# USAGE: Choose default command for starting new nvim client:
#
#   NVIM_OPEN_APPNAME="${NVIM_OPEN_APPNAME:-neovide}"
#   NVIM_OPEN_APPNAME="${NVIM_OPEN_APPNAME:-nvim}"

NVIM_OPEN_APPNAME="${NVIM_OPEN_APPNAME:-nvim}"

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

source_deps () {
  source_dep_homebrew
}

source_dep_homebrew () {
  [ -n "${HOMEBREW_PREFIX}" ] || return 0

  local brew_path="$(print_homebrew_path)"

  [ -x "${brew_path}" ] || return 0

  eval "$(${brew_path} shellenv)"
}

# USYNC: See DXY's `_depoxy_print_homebrew_path`:
#   https://github.com/DepoXy/depoxy#🍯
#     ~/.depoxy/ambers/core/brewskies.sh
#   https://github.com/DepoXy/depoxy/tree/HEAD/core/brewskies.sh
print_homebrew_path () {
  local brew_path=""

  # On Apple Silicon (arm64/AArch64) Macs (M1, M2, etc.) it's /opt/homebrew
  # - ALTLY: [ "$(uname -m)" = "arm64" ]
  [ -x "${brew_path}" ] || brew_path="/opt/homebrew/bin/brew"

  # On Intel Macs it's under /usr/local (tho deprecated)
  [ -x "${brew_path}" ] || brew_path="/usr/local/bin/brew"

  # On Linux, it's under /home (although there's no 'linuxbrew' account)
  # - Skip on Linux (on macOS, MacVim generally installed via Homebrew;
  #   but on Linux, author assumes most users get Vim from distro repo).
  # - INERT: We could check first if we need to engage Homebrew. But for
  #   now we'll just assume all macOS users need Homebrew to run MacVim.
  #
  #  [ -x "${brew_path}" ] || brew_path="/home/linuxbrew/.linuxbrew/bin/brew"

  [ -x "${brew_path}" ] || brew_path=""

  printf "%s" "${brew_path}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

gvim_open_kindness () {
  local server_id
  local row_number
  local col_number

  # 2021-08-19: Be clever and assume if any argument is a valid file
  # path, user chose not to bother specifing all non-file parameters.
  # - (I don't think we'll find a compelling use case where
  #    the user has a file with the same name as the given
  #    server id, or a file with only numbers that matches
  #    a row or column number argument, so this seems safe.)
  if [ -n "${1+x}" ] && [ ! -f "$1" ]; then server_id="$1"; shift; fi
  if [ -n "${1+x}" ] && [ ! -f "$1" ]; then row_number="$1"; shift; fi
  if [ -n "${1+x}" ] && [ ! -f "$1" ]; then col_number="$1"; shift; fi

  must_locate_executable_or_notify_and_exit

  local socket_path=""
  local server_arg=""
  local is_server_running=true
  gvim_ensure_server_id_or_use_default "${server_id}"

  # Fallback on a named file if the user doesn't specify a file to open,
  # because a bare command, e.g., gvim --servername ${server_id}, opens
  # a new gVim with the name "${server_id}1". Don't know why. (And does
  # not have to be a reST file, I just have an empty README in my home.)
  # MAYBE/2021-02-21: There's probably a way to open a new file to edit.
  # TRYME/2022-10-13: What happens if the target file does not exist?
  if [ -z "${1+x}" ]; then
    set -- "${HOME}/README.rst"
  fi

  gvim_relocate_cursor_to_editing_window "${server_arg}"

  gvim_open_files "${server_arg}" "${socket_path}" "$@"

  gvim_sleep_briefly_macvim_needs_a_moment

  gvim_move_cursor_to_line_and_column "${server_arg}" "${row_number}" "${col_number}"

  gvim_bring_window_to_front "${server_id}"
}

# ***

is_editor_gvim () {
  test "${GVIM_OPEN_EDITOR:-GVIM}" = "GVIM"
}

gvim_procname () {
  if is_editor_gvim; then
    # Runs MacVim on macOS.
    printf "%s" "gvim"
  else
    # Use nvim to communicate with NVIM_OPEN_APPNAME instance.
    printf "%s" "nvim"
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# Prepare PATH so this script can call `gvim` without a full path.
#
# When this script is used by a Keyboard Shortcut, only a basic shell
# is initialized, and `gvim` might not be found on the default PATH.
#
# - E.g., when Karabiner-Elements (macOS) calls this script, the PATH
#   is very simple: /usr/bin:/bin:/usr/sbin:/sbin.
#
#   But Home Brew installs MacVim to /usr/local/bin (older Intel Macs),
#   or to /opt/homebrew/bin (newer arm64 Apple Silicon), which is not on
#   PATH by default.
#
# - On MATE (at least this is the PATH that I see; I'm not sure if it's
#   common to include ~/.local/bin), a mate-panel launcher PATH reports:
#     /home/user/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:
#       /usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin

must_locate_executable_or_notify_and_exit () {
  PATH="/usr/local/bin:${PATH}"

  # Aka ${HOMEBREW_PREFIX}
  local brew_home="/opt/homebrew"
  # Otherwise on Intel Macs it's under /usr/local.
  [ -d "${brew_home}" ] || brew_home="/usr/local"
  #
  if [ -d "${brew_home}" ]; then
    # Support Karabiner-Elements with MacVim at brew-installed location;
    # also to find `terminal-notifier`.
    PATH="${brew_home}/bin:${PATH}"
  fi

  # Support Linux users with custom build at conventional location.
  PATH="${HOME}/.local/bin:${PATH}"

  must_verify_command "$(gvim_procname)"

  if ! is_editor_gvim; then
    if [ "${NVIM_OPEN_APPNAME}" != "neovide" ] \
      && [ "${NVIM_OPEN_APPNAME}" != "nvim" ] \
    ; then
      # USAGE: Add new editor support to gvim_open_files, below.
      >&2 echo "ERROR: Unrecognized Neovim app: ${NVIM_OPEN_APPNAME}"

      exit_1
    fi

    must_verify_command "${NVIM_OPEN_APPNAME}"
  fi
}

must_verify_command () {
  local cmd="$1"

  if ! type "${cmd}" > /dev/null 2>&1; then
    stderr_or_desktop_notify "gvim-open-kindness" "Where's ${cmd}?"

    exit_1
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# In case of trouble, try notifying user via desktop notification.
#
# Because this script is used in contexts (OS Keyboard Shortcuts)
# where we cannot communicate with the user how we normally might
# (e.g., stdout or stderr), try using a desktop notification.
#
# - On Linux, we can look for notify-send, which is pretty standard.
#
# - On macOS, we can look for terminal-notifier, which is just a nice
#   project I found that the user needs to (brew-)install themselves.
#
# - (And I dunno how useful this is, but at least it's something:)
#   If neither desktop notifier found, dump the message to a temporary
#   file. Not that non-developer users will know to look there (unless
#   we document it), but at least if anyone asks, we'll have something
#   to suggest which is easy to do.
#
#   - Note that on Linux, `mktemp` generally uses /tmp, but on macOS
#     you'll see a different path, e.g.,
#
#       @macOS $ mktemp
#       /var/folders/cs/h762zc8951zdm1ycc_2zqwb9l60wrb/T
#
#       @macOS $ echo $TMPDIR
#       /var/folders/cs/h762zc8951zdm1ycc_2zqwb9l60wrb/T/      
#
#     But there's still a /tmp directory nonetheless:
#
#       @macOS $ ll /tmp
#       /tmp -> private/tmp
#
#     And thankfully the `mktemp` command lets us use that path (which
#     simplifies troubleshooting, otherwise we would need to tell the
#     user to look under $TMPDIR; seems easier to just tell 'em /tmp):
#
#       @macOS $ mktemp /tmp/HELLO.XXXXXX
#       /tmp/HELLO.3vkABm
#
# - CAVEAT: In my experience, notify-send does nothing when passed
#   a long string, e.g., from my terminal, this does nothing:
#
#     notify-send "PATH=$PATH"
#
#   but it works if I trucate it:
#
#     notify-send "PATH=$(expr substr "${PATH}" 1 200)"

stderr_or_desktop_notify () {
  stdout_isatty () { [ -t 1 ]; }

  if stdout_isatty; then
    >&2 echo "ERROR: $@"
  else
    desktop_notify "$@"
  fi
}

desktop_notify () {
  local summary="$1"
  local body="$2"

  if command -v notify-send > /dev/null; then
    # Linux
    notify-send "${summary}" "${body}"
  elif command -v terminal-notifier > /dev/null; then
    # macOS — e.g., /opt/homebrew/bin/terminal-notifier
    #  Or /usr/local/bin/terminal-notifier
    # - Without -title, prints "Terminal".
    #   With -title "", prints "terminal-notifier".
    #   Note -subtitle is second line, bolded, and -message
    #   is third line, not bolded; only -message is required.
    terminal-notifier -message "${body}" -title "${summary}"
  else
    # Undesirable branch.

    local tempfile
    tempfile="$(mktemp /tmp/$(basename -- "$0").XXXXXX)" || exit_1

    echo "ERROR: ${summary}: ${body}" >> "${tempfile}"
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# `local` vars. set for caller:
#  local server_id
#  local server_arg
#  local socket_path
#  local is_server_running
gvim_ensure_server_id_or_use_default () {
  local server_id_arg="$1"

  server_id="${server_id_arg}"
  socket_path=""
  server_arg=""
  is_server_running=true

  if is_editor_gvim; then
    if [ -z "${server_id}" ]; then
      server_id="${GVIM_OPEN_SERVERNAME:-GVIM}"
    fi
    server_arg="--servername ${server_id}"
    # We don't need to know if GVim instance running already or not.
    is_server_running=true
  else
    if [ -z "${server_id}" ]; then
      server_id="${NVIM_OPEN_SOCKETNAME:-NVIM}"
    fi
    socket_path="/tmp/nvim.socket-${server_id}"
    # This won't work unless we `eval` the command later:
    #   server_arg="--server \"${socket_path}\""
    server_arg="--server ${socket_path}"
    is_server_running=$(test -S ${socket_path} && echo true || echo false)
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# REFER/2024-12-15: Calls (optional) FocusCursorInNormalBufferWindow in
#   https://github.com/embrace-vim/vim-buffer-delights#🍧
# ~/.vim/pack/embrace-vim/start/vim-buffer-delights/autoload/embrace/windows.vim

# Adjust the Vim cursor before opening the file, if necessary, so
# the new buffer does not replace the quickfix buffer, an open help
# file, or the project tray, etc.
#
# Note that `man gvim` says --cmd is 'executed just before processing
# any vimrc', but that doesn't mean it runs before the file is loaded.
# Or even after, as far as I could tell (doesn't seem to run at all).
#
# - So sending keystrokes to invoke command via --remote-send.
#
# Also, --remote-send fails if the server is not started, e.g.,
#   E247: no registered server named "GVIM": Send failed.
# so toss the stderr stream.
#
# Finally, use `silent!` to ignore error if autoload/ fcn. absent. 

gvim_relocate_cursor_to_editing_window () {
  local server_arg="$1"

  if ! ${is_server_running}; then

    return
  fi

  # If gvim not running, e.g.:
  #   E247: No registered server named "GVIM": Send failed.

  # MAYBE/2025-01-24: If is_server_running, nvim shouldn't generate any output,
  # so we could remove the stream inhibitors. Though if it fails, it might be
  # a lot of garbage output.
  $(gvim_procname) \
    ${server_arg} \
    --remote-send "<ESC>:silent! call g:embrace#windows#FocusCursorInNormalBufferWindow()<CR>" \
    > /dev/null 2>&1 \
    || is_server_running=false
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# Send gvim outputs to null, aka the bit bucket, black hole, null route,
# punch (card) bucket, or possibly most technically the null device.
#
# DUNNO/2024-10-18: On macOS, you might otherwise see spew going to
# whatever terminal opened gvim, e.g.:
#
#   Vim(55510) MallocStackLogging: can't turn off malloc stack logging because it was not enabled.
#   Vim(55514) MallocStackLogging: can't turn off malloc stack logging because it was not enabled.
#   Vim(55518) MallocStackLogging: can't turn off malloc stack logging because it was not enabled.
#   ...

gvim_open_files () {
  local server_arg="$1"
  local socket_path="$2"
  shift 2

  # DUNNO: Relative paths don't work with nvim, apparently:
  #   cd ~/path/to/gvim-open-kindness
  #   nvim --server /tmp/neovide.socket --remote-silent bin/nvim-open-kindness
  # Opens the file: ~/bin/nvim-open-kindness

  if ! ${is_server_running} && ! is_editor_gvim; then
    # Run user's preferred GUI, e.g., Neovide
    ${NVIM_OPEN_APPNAME:-neovide} -- --listen ${socket_path} "$@" & \
      2>/dev/null
  else
    # gvim or nvim
    eval "$(gvim_procname) ${server_arg} \
      --remote-silent $(expand_paths "$@") \
      2>/dev/null"
  fi
}

# Handles any path characters except double quote.
expand_paths () {
  for path in "$@"; do
    printf "${path}\0"
  done \
    | xargs -0 realpath \
    | $(command -v gsed || command -v sed) 's/^\(.*\)$/"\1"/' \
    | tr "\n" " "
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# On macOS, sleep briefly after loading the file. Otherwise, if the file
# was not already loaded, the next command, which calls `:call cursor()`
# (gvim_move_cursor_to_line_and_column), would be ignored, at least IME.
#
# (I tried sleep 0.33 for a bit and had limited success; and 0.5 worked
#  for a while, until it didn't; so latest attempt is to wait 2/3 of a
#  second for file load to settle in gVim, then try jumping cursor.)

gvim_sleep_briefly_macvim_needs_a_moment () {
  if ! os_is_macos || ! is_editor_gvim; then

    return
  fi

  sleep 0.667
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

gvim_move_cursor_to_line_and_column () {
  local server_arg="$1"
  local row_number="$2"
  local col_number="${3:-0}"

  if [ -z "${row_number}" ] || [ -z "${col_number}" ]; then
    return
  fi

  $(gvim_procname) \
    ${server_arg} \
    --remote-send "<ESC>:call cursor(${row_number}, ${col_number})<CR>"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# Bring gVim to front. This happens automatically on macOS.

# (lb): I didn't enable this for Linux until I saw the behavior in macOS.
# Because it's more often than not that I want to use Vim after opening a
# file in it, I enabled this behavior for X11.

# FTREQ/2025-01-25: Add Wayland path.
# - For now, xdotool may work if GVim uses Xwayland.

gvim_bring_window_to_front () {
  if ! os_is_macos; then
    gvim_bring_window_to_front_X "$@"
  else
    gvim_bring_window_to_front_macOS "$@"
  fi
}
  
gvim_bring_window_to_front_X () {
  local server_id="$1"

  # On macOS, (thankfully) gVim fronts automatically (and there's no xdotool).
  if os_is_macos || ! command -v xdotool >/dev/null; then

    return 0
  fi

  # On Linux, or at least Linux Mint MATE, gVim doesn't front on its
  # own. So go grab it.
  # - Note that xdotool (for me) spits out an error message:
  #     XGetWindowProperty[_NET_WM_DESKTOP] failed (code=1)
  #   but it works nonetheless, so chuck the error.
  xdotool search --name "${server_id}" windowactivate > /dev/null 2>&1
}
  
# REFER: Requires Hammyspoony Hammerspoon Spoon to front nvim TUI:
#
#   https://github.com/DepoXy/macOS-Hammyspoony#🥄

gvim_bring_window_to_front_macOS () {
  local server_id="$1"

  if ! ${is_server_running} || is_editor_gvim; then

    return 0
  fi

  if is_editor_gvim; then
    # MacVim fronts itself.
    # - If you have another use case (e.g., terminal Vim),
    #   add it here (e.g., call hammerspoon://setFrontmost).
    :
  elif [ "${NVIM_OPEN_APPNAME}" = "nvim" ]; then
    open -g "hammerspoon://setFrontmost?name=${server_id}" \
      2> /dev/null \
      || true
  else
    # E.g., "neovide"
    open -a "${NVIM_OPEN_APPNAME}" \
      || true
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

os_is_macos () {
  [ "$(uname)" = "Darwin" ]
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

clear_traps () {
  trap - EXIT INT
}

set_traps () {
  trap -- trap_exit EXIT
  trap -- trap_int INT
}

exit_0 () {
  clear_traps

  exit 0
}

exit_1 () {
  clear_traps

  exit 1
}

trap_exit () {
  clear_traps

  # USAGE: Alert on unexpected error path, so you can add happy path.
  >&2 echo "ALERT: "$(basename -- "$0")" exited abnormally!"
  >&2 echo "- Hint: Enable \`set -x\` and run again..."

  exit 2
}

trap_int () {
  clear_traps

  exit 3
}

# ***

SCRIPT_NAME_GVIM="gvim-open-kindness"
SCRIPT_NAME_NVIM="nvim-open-kindness"

main () {
  local proc_bname
  proc_bname="$(basename -- "$0")"

  local run_as=""

  # Run the function if being executed.
  # Otherwise being sourced, so do not.
  if [ "${proc_bname}" = "${SCRIPT_NAME_GVIM}" ]; then
    run_as="GVIM"
  elif [ "${proc_bname}" = "${SCRIPT_NAME_NVIM}" ]; then
    run_as="NVIM"
  else

    return
  fi

  # ***

  set -e

  set_traps

  # ***

  source_deps

  GVIM_OPEN_EDITOR=${GVIM_OPEN_EDITOR:-${run_as}}

  gvim_open_kindness "$@"

  # ***

  clear_traps
}

main "$@"

